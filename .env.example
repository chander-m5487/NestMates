# =============================================================
# NestMates — Environment Variables Template
# Copy this file to .env and fill in your values.
# This file IS safe to commit — it contains NO real secrets.
# =============================================================

# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# Auth / JWT signing — used for session cookies and OTP sign-in
# Generate with: openssl rand -base64 64
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""          # openssl rand -base64 64

# Message Encryption (32 bytes hex — NEVER change in production)
ENCRYPTION_KEY=""           # openssl rand -hex 32

# Cron Job Protection
CRON_SECRET=""              # openssl rand -hex 32

# Email / SMTP
# Use a dedicated Gmail account (e.g. nestmates.app@gmail.com)
# Steps: Enable 2-Step Verification → myaccount.google.com/apppasswords → create App Password
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""                # e.g. nestmates.app@gmail.com
SMTP_PASS=""                # 16-char Gmail App Password (NOT your account password)
EMAIL_FROM="NestMates <nestmates.app@gmail.com>"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

NODE_ENV="development"
